{
  "name": "product-master-data",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": ["frontend"],
  "scripts": {
    "dev:web": "bun run --filter frontend dev",
    "build:web": "bun run --filter frontend build",
    "lint:web": "bun run --filter frontend lint",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "api:build": "dotnet build ProductMasterData.slnx",
    "api:test": "dotnet test ProductMasterData.slnx",
    "check": "bun run build:web && bun run lint:web && bun run api:build && bun run api:test"
  }
}
